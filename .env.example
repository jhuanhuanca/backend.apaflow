APP_NAME="Tesis Formatter AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tesis_formatter
DB_USERNAME=root
DB_PASSWORD=

# Laravel no tiene driver de sesión llamado "cookie" (la cookie del navegador guarda el id; el backend usa file/database/redis).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Redis (producción: ver deploy/env/backend.production.env.example) ---
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

PYTHON_SERVICE_URL=http://127.0.0.1:8001
PYTHON_SERVICE_TIMEOUT=300
# PYTHON_SERVICE_API_KEY=   # Mismo valor que AI_SERVICE_API_KEY en ai-service-python

# Origen exacto del SPA (coma si hay varios). Producción: https://apaflow.shop,https://admin.apaflow.shop
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=true

# Host:puerto del frontend (sin esquema). Producción: apaflow.shop,admin.apaflow.shop
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,::1
# Producción + SESSION_DOMAIN=.apaflow.shop + SESSION_SECURE_COOKIE=true

# Demostración: simular pago y activar Pro desde el panel (true/false). Si no se define, sigue APP_DEBUG.
PAYMENT_DEMO_UPGRADE=

# Límites modo invitado (sincronizados con clientes vía GET /api/config)
GUEST_MAX_UPLOADS=1
GUEST_MAX_FREE_DOWNLOADS=1

# Precios (sincronizados con GET /api/config)
PRICE_PER_DOCUMENT_CENTS=99
PRICE_PER_DOCUMENT_FORMATTED="$0.99"
PRO_MONTHLY_CENTS=599
PRO_MONTHLY_FORMATTED="$5.99"

# Duración de suscripción PRO (días) tras cada pago confirmado
PRO_SUBSCRIPTION_DURATION_DAYS=30

# Al vencer PRO: eliminar documentos, logs, archivos y preferencias APA del usuario (true/false)
PRO_PURGE_HISTORY_ON_EXPIRY=true

# Plan FREE: retención de documentos (días). Tras ese plazo se eliminan automáticamente.
FREE_DOCUMENT_RETENTION_DAYS=30
FREE_DOCUMENT_RETENTION_ENABLED=true

# Marca expuesta a Vue y Flutter
SAAS_BRAND_NAME="APA Flow"
SAAS_BRAND_TAGLINE="Convierte tu Word a formato APA 7"

# Anuncios (config/ads.php — expuesto en GET /api/config)
ADS_ENABLED=true
ADS_PROVIDER=adsense
ADSENSE_PUBLISHER_CLIENT=ca-pub-2981754691104078
ADS_LAZY_LOAD=true

# --- Pasarelas de pago (config/payments.php). "manual" no requiere claves. ---
# auto | paddle | demo — auto usa Paddle si hay credenciales, si no demo (si APP_DEBUG).
PAYMENT_PROVIDER=auto

# Paddle Billing (https://developer.paddle.com/)
PADDLE_ENABLED=true
PADDLE_SANDBOX=true
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=pro_01kthvvxqt8ydftnc4b6nmpvaf
PADDLE_PRICE_DOCUMENT=pro_01kthvpgmh491467ga6dr2jn8t
# Opcional: si no se definen, se generan desde FRONTEND_URL por flujo de pago
# PADDLE_CHECKOUT_SUCCESS_URL=
# PADDLE_CHECKOUT_CANCEL_URL=

STRIPE_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PAYU_API_KEY=
PAYU_MERCHANT_ID=
